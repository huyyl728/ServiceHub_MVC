@model IReadOnlyList<ServiceHubMVC.Models.OwnerRequest>

@{
    ViewData["Title"] = "Duyệt đăng ký Chủ cơ sở";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            Quản lý yêu cầu đăng ký Chủ cơ sở
        </h2>

        <p class="text-muted">
            Kiểm tra và phê duyệt các đối tác mới của ServiceHub.
        </p>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-muted">
                Yêu cầu đang chờ duyệt
            </h6>

            <h2 class="fw-bold text-primary">
                @Model.Count
            </h2>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Hiện không có yêu cầu nào đang chờ xét duyệt.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Mã yêu cầu</th>
                            <th>Người đăng ký</th>
                            <th>Tên cơ sở</th>
                            <th>Địa chỉ</th>
                            <th>Thông tin bổ sung</th>
                            <th>Thời gian gửi (UTC)</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>

                                <td>
                                    <strong>@item.User.FullName</strong>
                                    <div class="small text-muted">
                                        @item.User.Email
                                    </div>
                                </td>

                                <td>@item.BusinessName</td>

                                <td>@item.BusinessAddress</td>

                                <td>@item.Reason</td>

                                <td>
                                    @item.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">

                                        <form asp-action="Approve"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              asp-antiforgery="true"
                                              onsubmit="return confirm('Bạn có chắc muốn cấp quyền Owner?');">

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">
                                                Phê duyệt
                                            </button>

                                        </form>

                                        <form asp-action="Reject"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              asp-antiforgery="true"
                                              onsubmit="return confirm('Bạn có chắc muốn từ chối yêu cầu?');">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                Từ chối
                                            </button>

                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>