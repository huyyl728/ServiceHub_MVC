@model ServiceHubMVC.Models.OwnerRequest
@using ServiceHubMVC.Models

@{
    ViewData["Title"] = "Trạng thái đăng ký";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">
        Trạng thái đăng ký Chủ cơ sở
    </h2>

    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    @if (Model is null)
    {
        <div class="alert alert-info">
            Bạn chưa gửi yêu cầu đăng ký nào.
        </div>

        @if (User.IsInRole("Customer") &&
             !User.IsInRole("Owner"))
        {
            <a asp-action="Apply"
               class="btn btn-primary">
                Đăng ký làm Chủ cơ sở
            </a>
        }
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <h4>@Model.BusinessName</h4>

                <p>
                    <strong>Địa chỉ:</strong>
                    @Model.BusinessAddress
                </p>

                <p>
                    <strong>Thông tin bổ sung:</strong>
                    @Model.Reason
                </p>

                @switch (Model.Status)
                {
                    case OwnerRequestStatus.Pending:

                        <span class="badge bg-warning text-dark">
                            Đang chờ xét duyệt
                        </span>

                        <p class="mt-3">
                            Vui lòng chờ quản trị viên
                            kiểm tra yêu cầu.
                        </p>

                        break;

                    case OwnerRequestStatus.Approved:

                        <span class="badge bg-success">
                            Đã phê duyệt
                        </span>

                        <p class="mt-3">
                            Hãy đăng xuất và đăng nhập lại
                            để cập nhật quyền Owner.
                        </p>

                        break;

                    case OwnerRequestStatus.Rejected:

                        <span class="badge bg-danger">
                            Đã từ chối
                        </span>

                        <div class="mt-3">
                            <a asp-action="Apply"
                               class="btn btn-primary">
                                Gửi lại yêu cầu
                            </a>
                        </div>

                        break;
                }

            </div>
        </div>
    }

</div>
