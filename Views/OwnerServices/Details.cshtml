@model Service
@{ ViewData["Title"] = "Chi tiết dịch vụ"; }
<h1>@Model.Name</h1>
<dl><dt>Cơ sở</dt><dd>@Model.Business.Name</dd><dt>Danh mục</dt><dd>@Model.Category</dd><dt>Mô tả</dt><dd>@Model.Description</dd><dt>Giá</dt><dd>@Model.Price.ToString("N2") VNĐ</dd><dt>Thời lượng</dt><dd>@Model.DurationMinutes phút</dd><dt>Trạng thái</dt><dd>@(Model.IsAvailable ? "Đang mở" : "Tạm ngừng")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
<a asp-action="Index" asp-route-businessId="@Model.BusinessId">Quay lại</a>
