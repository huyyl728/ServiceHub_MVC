@model ServiceHubMVC.ViewModels.ServiceDetailViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Controllers
@using Microsoft.AspNetCore.Mvc.Infrastructure
@using Microsoft.AspNetCore.Mvc.ActionConstraints
@inject IActionDescriptorCollectionProvider Actions
@{
    ViewData["Title"] = Model.Service.Name;
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var item = Model.Service;
    // Chỉ mở biểu mẫu khi điểm gọi nghiệp vụ POST đã được đăng ký.
    var canSubmit = Actions.ActionDescriptors.Items.OfType<ControllerActionDescriptor>().Any(a =>
        a.ControllerName == "Services" && a.ActionName == "Book" &&
        a.ActionConstraints?.OfType<HttpMethodActionConstraint>().Any(c =>
            c.HttpMethods.Contains("POST", StringComparer.OrdinalIgnoreCase)) == true);
    var canLogin = Actions.ActionDescriptors.Items.OfType<ControllerActionDescriptor>().Any(a =>
        a.ControllerName == "Account" && a.ActionName == "Login" &&
        (a.ActionConstraints?.OfType<HttpMethodActionConstraint>().Any() != true ||
            a.ActionConstraints.OfType<HttpMethodActionConstraint>().Any(c => c.HttpMethods.Contains("GET", StringComparer.OrdinalIgnoreCase))));
}
<a asp-controller="Services" asp-action="Index" class="d-inline-block mb-3">← Về danh sách dịch vụ</a>
<div class="row g-4">
    <div class="col-12 col-lg-7">
        <article class="content-panel">
            <span class="badge bg-light text-dark">@item.Category</span>
            <h1 class="h2 fw-bold mt-3">@item.Name</h1>
            <p class="text-muted">@item.BusinessName · @item.Address</p>
            <dl class="row g-2 border-top pt-3">
                <dt class="col-sm-5">Giá dịch vụ</dt>
                <dd class="col-sm-7 fw-bold text-primary">@item.Price.ToString("N0", culture) đ</dd>
                <dt class="col-sm-5">Thời lượng</dt>
                <dd class="col-sm-7">@item.DurationMinutes phút</dd>
            </dl>
            <h2 class="h5">Giới thiệu dịch vụ</h2>
            <p class="mb-0" style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả." : Model.Description)</p>
        </article>
    </div>
    <div class="col-12 col-lg-5">
        <section class="content-panel">
            <h2 class="h4 fw-bold">Đặt lịch hẹn</h2>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <p>Bạn cần đăng nhập bằng tài khoản khách hàng để đặt lịch.</p>
                @if (canLogin)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Services", new { id = item.Id })" class="btn btn-primary w-100">Đăng nhập</a>
                }
            }
            else if (!User.IsInRole("Customer"))
            {
                <p class="alert alert-warning mb-0">Chỉ tài khoản khách hàng có thể đặt lịch.</p>
            }
            else if (!canSubmit)
            {
                <p class="alert alert-info mb-0">Chức năng đặt lịch chưa khả dụng.</p>
            }
            else
            {
                <form asp-controller="Services" asp-action="Book" asp-route-id="@item.Id" method="post" asp-antiforgery="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <label asp-for="StartTimeLocal" class="form-label">Ngày và giờ bắt đầu</label>
                    <input asp-for="StartTimeLocal" type="datetime-local" class="form-control" required aria-describedby="time-help" />
                    <span asp-validation-for="StartTimeLocal" class="text-danger"></span>
                    <p id="time-help" class="small text-muted mt-2">Giờ Việt Nam (UTC+7). Giá và thời lượng được máy chủ xác nhận khi đặt lịch.</p>
                    <button type="submit" class="btn btn-primary w-100">Xác nhận đặt lịch</button>
                </form>
            }
        </section>
    </div>
</div>
