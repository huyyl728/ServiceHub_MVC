@model IReadOnlyList<Business>
@{ ViewData["Title"] = "Quản lý cơ sở"; }
<h1>Quản lý cơ sở</h1>
<partial name="_OwnerResourceMessages" />
<a asp-action="Create" class="btn btn-primary mb-3">Thêm cơ sở</a>
@if (Model.Count == 0) { <p>Chưa có cơ sở nào.</p> }
<div class="table-responsive">
<table class="table align-middle">
    <thead><tr><th>Tên</th><th>Địa chỉ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Name</td><td>@item.Address</td><td>@(item.IsActive ? "Đang hoạt động" : "Tạm ngừng")</td><td>
            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
            <a asp-controller="OwnerServices" asp-action="Index" asp-route-businessId="@item.Id" class="btn btn-sm btn-outline-primary">Dịch vụ</a>
            <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline" asp-antiforgery="true">
                <input type="hidden" name="active" value="@(!item.IsActive ? "true" : "false")" />
                <button class="btn btn-sm btn-warning" type="submit">@(item.IsActive ? "Tạm ngừng" : "Mở lại")</button>
            </form>
            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" asp-antiforgery="true" onsubmit="return confirm('Bạn có chắc muốn xóa cơ sở này?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
            </form>
        </td></tr>
    }
    </tbody>
</table>
</div>
