@model ServiceHubMVC.ViewModels.UpdateProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Hồ sơ cá nhân</h1>
        @if (TempData["SuccessMessage"] is string message)
        {
            <div class="alert alert-success" role="status">@message</div>
        }
        <form asp-controller="Account" asp-action="Profile" method="post" asp-antiforgery="true" data-prevent-repeat>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label" for="accountEmail">Email</label>
                <input id="accountEmail" class="form-control" value="@ViewData["Email"]" readonly />
                <div class="form-text">Email chỉ hiển thị, không thể thay đổi tại đây.</div>
            </div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
            <p class="form-processing"
   data-processing-message
   role="status"
   hidden>
    Đang lưu thông tin...
</p>
        </form>
        <hr />
        <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="true">
            <button class="btn btn-outline-danger" type="submit">Đăng xuất</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
