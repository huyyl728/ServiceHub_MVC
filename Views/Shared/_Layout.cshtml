<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Đến nội dung chính</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Service<span>Hub</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở hoặc đóng menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <partial name="_Navigation" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="container py-4 py-lg-5 flex-grow-1">
        <partial name="_StatusMessages" />
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 py-4">
            <span>© @DateTime.Now.Year ServiceHub · Đặt lịch dịch vụ trực tuyến</span>
            <a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
