<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f595ec04-7854-4a7e-8426-616fe4c1a2fc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
 <ItemGroup>
  <!-- Không đưa mã nguồn kiểm thử vào ứng dụng web -->
  <Compile Remove="tests/**/*.cs" />
  <Content Remove="tests/**" />
  <None Remove="tests/**" />
</ItemGroup>
  <ItemGroup>
    <!-- Secrets must never enter build/publish artifacts, even when present locally. -->
    <Content Remove="appsettings.*.local*.json;**/appsettings.*.local*.json;**/TAI_KHOAN_SERVICEHUB_NOI_BO.txt;**/*TEAM_ACCOUNTS_PRIVATE*;**/*.private.env;**/team-secrets*.txt" />
    <None Remove="appsettings.*.local*.json;**/appsettings.*.local*.json;**/TAI_KHOAN_SERVICEHUB_NOI_BO.txt;**/*TEAM_ACCOUNTS_PRIVATE*;**/*.private.env;**/team-secrets*.txt" />
  </ItemGroup>
</Project>
